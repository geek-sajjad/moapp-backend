#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Get staged files
STAGED_FILES=$(git diff --cached --name-only)

# Check for JS/TS files (adjust as needed)
SHOULD_RUN=$(echo "$STAGED_FILES" | grep -E '\.(js|ts|tsx)$' || true)

if [ -n "$SHOULD_RUN" ]; then
  # echo "Running linting..."
  # npm run lint

  echo "Linting completed."

  # echo "Running formatting..."
  # npm run format

  echo "Formatting completed."

  echo "All operations are completed. Ready to commit!"
else
  echo "No JS/TS files changed, skipping lint/format."
fi

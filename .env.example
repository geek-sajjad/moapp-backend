# Application configuration
APP_NAME="base_template"
APP_VERSION=1.0.0
APP_PORT=3000
NODE_ENV=local
MAX_FILE_SIZE=3 # mb
FILE_PATH=images
APP_URL=

# Swagger
SWAGGER_TITLE=Service
SWAGGER_VERSION=1.0.0

# Cors
FRONTEND_URL=frontend.com


# JWT configuration
JWT_SECRET=mySuperSecretKey
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Email
MAILTRAP_TOKEN=
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_Name=

# Firebase Configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OTP
MAX_ATTEMPS=
LOCK_DURATION_MINUTES= # MINUTE
EXPIRE_AFTER= # MINUTE

# Twilio 
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Digital ocean s3
DIGITAL_OCEAN_ENDPOINT=
DIGITAL_OCEAN_REGION=
DIGITAL_OCEAN_ACCESS_KEY=
DIGITAL_OCEAN_SECRET_KEY=
DIGITAL_OCEAN_FILE_BUCKET=

#Whatsapp
# Specifies the base URL for the WhatsApp Cloud API, which is hosted on Facebook's Graph API.
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# Represents the access token used for authenticating API requests; it should be a secret key provided by Facebook.
WHATSAPP_API_ACCESS_TOKEN=

# dentifies the WhatsApp phone number registered in the Cloud API to send and receive messages.
WHATSAPP_PHONE_NUMBER_ID=


# Database section
# =======================================================================

# MongoDB
MONGO_URI=mongodb://localhost:27017/mydatabase
MONGO_USER=user
MONGO_PASSWORD=yourpassword

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_passowrd
POSTGRES_DB=test


# =======================================================================



# Default Images
DEFAULT_PROFILE_IMAGE=https://via.placeholder.com/400x300?text=Default+Image
DEFAULT_MEAL_IMAGE=https://via.placeholder.com/400x300?text=Default+Image
DEFAULT_PLAN_IMAGE=https://via.placeholder.com/400x300?text=Default+Image
DEFAULT_IMAGE=https://via.placeholder.com/400x300?text=Default+Image